# ── Django ──
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=example.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.com

# ── Ma'lumotlar bazasi (PostgreSQL) ──
DB_NAME=mbc_db
DB_USER=mbc_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ── Telegram botlar ──
CLIENT_BOT_TOKEN=
WORKER_BOT_TOKEN=
TELEGRAPH_TOKEN=

# ── Telegram kanal/guruh ID lari (global — server va lokalda bir xil) ──
PRIVATE_CHANNEL_ID=
PRIVATE_GROUP_ID=
TRIPS_GROUP_ID=
WORK_GROUP_ID=

# ── Ovozni matnga aylantirish (Groq Whisper — tekin: console.groq.com) ──
GROQ_API_KEY=

# ── Adminlar (vergul bilan ajratilgan Telegram ID lar) ──
ADMIN_IDS=

# ── Eski bazadan ko'chirish (faqat import_old_db kerak bo'lsa) ──
OLD_DB_NAME=mbc_old
OLD_DB_USER=postgres
OLD_DB_PASSWORD=
OLD_DB_HOST=localhost
OLD_DB_PORT=5432
